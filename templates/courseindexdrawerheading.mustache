{{!
    @template theme_accessible/courseindexdrawerheading

    Heading of the course index drawer: a button back to the course page, shown only inside an activity (courseurl is
    empty elsewhere). Boost shows the full course name here, which is cut or very long for long titles; this shows an
    arrow and the text "Back to the course" and keeps the full name in the accessible name and tooltip.

    Example context (json):
    {
        "coursefullname": "Full name of the course",
        "courseurl": "http://example.com/course/view.php?id=2"
    }
}}
{{#courseurl}}
<div id="courseindexdrawerheading">
    <a
        class="courseindex-link fw-bold"
        href="{{courseurl}}"
        title="{{coursefullname}}"
        aria-label="{{#str}}backtocourse, theme_accessible{{/str}}: {{coursefullname}}"
    >{{! Core's dir-rtl-hide / dir-ltr-hide (body dir-ltr / dir-rtl): the arrow points back in both directions. }}<i class="fa-solid fa-arrow-left dir-rtl-hide" aria-hidden="true"></i><i class="fa-solid fa-arrow-right dir-ltr-hide" aria-hidden="true"></i><span>{{#str}}backtocourse, theme_accessible{{/str}}</span></a>
</div>
{{/courseurl}}
