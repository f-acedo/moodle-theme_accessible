{{!
    Accessible override of the core notification templates (this file and the four that extend it): same markup plus
    the type of the alert (Error, Success, Warning, Information) as visible text before the message (also read by screen readers) and as a tooltip over the icon
    area. The core alerts say their type only with a colour, a pattern and an icon, which a screen reader cannot read.
}}
{{!
    @template core/notification_base

    Base Moodle notification template.

    The purpose of this template is to render an base template for alert notifications.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * message A cleaned string (use clean_text()) to display.
    * extraclasses Additional classes to apply to the notification.
    * closebutton Whether a close button should be displayed to dismiss the message.
    * announce Whether the notification should be announced to screen readers.
    * headinglevel The optional heading level to use for the title (1-6). Defaults to 3.

    Example context (json):
    {
        "message": "<p>Hello <a href=\"#\">World!</a></p><p>Your pants are on fire!</p>",
        "closebutton": 1,
        "announce": 1,
        "extraclasses": "foo bar",
        "title": "Notification title",
        "titleicon": {
            "icon": "i/circleinfo",
            "component": "core"
        }
    }
}}
<div class="alert {{$alertclass}}alert-secondary{{/alertclass}} alert-block fade in {{ extraclasses }} {{#closebutton}}alert-dismissible{{/closebutton}}" {{!
        }}{{# announce }} role="alert" data-aria-autofocus="true"{{/ announce }}>
    {{$alerttype}}{{/alerttype}}
    {{#title}}
        <div class="mb-2 mt-1 d-flex alert-heading">
            {{#titleicon}}
                <span>
                    {{#pix}}{{icon}}, {{component}}{{/pix}}
                </span>
            {{/titleicon}}
            <h{{#headinglevel}}{{.}}{{/headinglevel}}{{^headinglevel}}3{{/headinglevel}} class="h6 mb-0">
                <span class="align-middle">{{.}}</span>
            </h{{#headinglevel}}{{.}}{{/headinglevel}}{{^headinglevel}}3{{/headinglevel}}>
        </div>
    {{/title}}
    {{{ message }}}
    {{# closebutton }}{{!
    }}<button type="button" class="btn-close" data-bs-dismiss="alert">
        <span class="visually-hidden">{{#str}}alertdismiss, theme_accessible{{/str}}</span>
    </button>{{!
    }}{{/ closebutton }}
</div>
