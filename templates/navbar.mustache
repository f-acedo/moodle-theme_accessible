{{!
    @template theme_accessible/navbar

    Simplified top navbar: site brand, primary navigation, search, language, user menu and edit switch.
    Only essential elements are shown, to reduce noise for blind and low-vision users.

    Example context (json):
    {
        "output": {
            "should_display_navbar_logo": true,
            "get_compact_logo_url": "http://placekitten.com/50/50",
            "page_heading_menu": "<li>..</li>",
            "search_box": "<div><input type='text'></div>",
            "navbar_plugin_output": "<div class='dropdown'>Messaging</div>",
            "edit_switch": "<div>Edit mode</div>"
        },
        "config": {
            "homeurl": "/my/"
        },
        "sitename": "Moodle Site",
        "accessibilityurl": "https://yourmoodlesite/theme/accessible/preferences.php",
        "accessibilitylabel": "Accessibility options",
        "primarymoremenu": {
            "text": "More",
            "classes": "",
            "navbaritems": []
        },
        "mobileprimarynav": [
            {
                "text": "Dashboard",
                "url": "/my",
                "isactive": true
            }
        ],
        "usermenu": {
            "unauthenticateduser": {
                "content": "You are not logged in",
                "url": "https://yourmoodlesite/login/index.php"
            }
        }
    }
}}
<nav class="navbar fixed-top bg-white navbar-expand" aria-label="{{#str}}sitenavigation, theme_accessible{{/str}}">
    <div class="container-fluid">
        {{#accessibilityurl}}
            {{! First in the reading order so screen reader users reach it at once; the CSS shows it at the far right. }}
            <a href="{{ accessibilityurl }}" class="accessible-options-link aabtn">
                <i class="fa-solid fa-universal-access" aria-hidden="true"></i>
                <span class="visually-hidden">{{ accessibilitylabel }}</span>
            </a>
        {{/accessibilityurl}}
        <button class="navbar-toggler aabtn d-block d-md-none px-1 my-1 border-0" data-toggler="drawers" data-action="toggle" data-target="theme_boost-drawers-primary">
            <span class="navbar-toggler-icon"></span>
            <span class="visually-hidden">{{#str}}openmainmenu, theme_accessible{{/str}}</span>
        </button>

        <a href="{{{ config.homeurl }}}" class="navbar-brand d-none d-md-flex align-items-center m-0 me-4 p-0 aabtn">
            {{# output.should_display_navbar_logo }}
                <img src="{{output.get_compact_logo_url}}" class="logo me-1" alt="{{sitename}}">
            {{/ output.should_display_navbar_logo }}
            {{^ output.should_display_navbar_logo }}
                {{{ sitename }}}
            {{/ output.should_display_navbar_logo }}
        </a>
        {{#primarymoremenu}}
            <div class="primary-navigation">
                {{> core/moremenu}}
            </div>
        {{/primarymoremenu}}

        {{# output.page_heading_menu}}
            <ul class="navbar-nav d-none d-md-flex my-1 px-1">
                {{{ output.page_heading_menu }}}
            </ul>
        {{/output.page_heading_menu}}

        <div id="usernavigation" class="navbar-nav ms-auto h-100">
            {{# output.search_box }}
                {{{ output.search_box }}}
                <div class="divider border-start h-75 align-self-center mx-1"></div>
            {{/output.search_box}}
            {{#langmenu}}
                {{> theme_boost/language_menu }}
                <div class="divider border-start h-75 align-self-center mx-1"></div>
            {{/langmenu}}
            {{{ output.navbar_plugin_output }}}
            {{#usermenu}}
                <div class="d-flex align-items-stretch usermenu-container" data-region="usermenu">
                    {{> core/user_menu }}
                </div>
            {{/usermenu}}
            {{{ output.edit_switch }}}
        </div>
    </div>
</nav>

{{> theme_boost/primary-drawer-mobile }}
