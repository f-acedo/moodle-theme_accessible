{{!
    @template theme_accessible/head

    Page header. Copy of theme_boost/head without the trailing slash on the <link> (a void element takes none in HTML).
    Keep in sync with Boost's head template when upgrading.

    Context variables required for this template:
    * output - The core renderer for the page (doctype, htmlattributes, page_title, favicon, standard_head_html)

    Example context (json):
    {
        "output": {
            "doctype": "<!DOCTYPE html>",
            "htmlattributes": "lang=\"en\" dir=\"ltr\"",
            "page_title": "Example page",
            "favicon": "favicon.ico",
            "standard_head_html": ""
        }
    }
}}
{{{ output.doctype }}}
<html {{{ output.htmlattributes }}}>
<head>
    <title>{{{ output.page_title }}}</title>
    <link rel="shortcut icon" href="{{{ output.favicon }}}">
    {{{ output.standard_head_html }}}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
