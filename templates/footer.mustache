{{!
    @template theme_accessible/footer

    Accessible page footer. Boost hides the footer behind a floating "?" button (and a floating communication
    room button); here it is always visible at the bottom of the page, in reading order, so screen reader and
    magnifier users find it without hunting for a floating control. The help/support links, the "logged in as"
    line, the Moodle version and "Powered by Moodle" are intentionally left out (Fer, 2026-10-18); standard_footer_html still adds
    plugin links such as the data retention summary.
    The "Back to top" button is fixed at the bottom right (styles.scss section 20).

    Example context (json):
    {
        "output": {
            "has_communication_links": true,
            "communication_link": "<a href=\"#\">Communication room</a>"
        }
    }
}}
<footer id="page-footer" class="accessible-footer">
    {{! First element of the footer, so keyboard users find it right after the main content. Shown by accessible.js
        once the page is scrolled; clicking it scrolls up and moves focus to the skip link. }}
    <button type="button" class="btn btn-secondary accessible-totop" data-action="accessible-totop" hidden>
        <i class="icon fa fa-arrow-up fa-fw" aria-hidden="true"></i>
        <span class="accessible-totop-label">{{#str}}backtotop, theme_accessible{{/str}}</span>
    </button>
    <div class="container">
        {{#output.has_communication_links}}
            <div class="footer-section footer-link-communication">
                <div class="footer-support-link">{{{ output.communication_link }}}</div>
            </div>
        {{/output.has_communication_links}}
        <div class="footer-section">
            <div class="tool_usertours-resettourcontainer">
            </div>
            {{# output.telemetry_traceid }}
                <div>
                    <span id="telemetry_traceid" class="d-none">
                        {{{ output.telemetry_traceid }}}
                    </span>
                    <a href="#" data-action="copytoclipboard" data-clipboard-target="#telemetry_traceid"
                            data-clipboard-success-message="{{#str}}telemetrytracecopied, theme_accessible{{/str}}">
                        {{#str}}telemetrytrace, theme_accessible{{/str}}
                    </a>
                </div>
            {{/ output.telemetry_traceid }}
            {{{ output.standard_footer_html }}}
            {{{ output.standard_end_of_body_html }}}
        </div>
    </div>

    <div class="footer-content-debugging footer-dark bg-dark text-light">
        <div class="container-fluid footer-dark-inner">
            {{{ output.debug_footer_html }}}
        </div>
    </div>
</footer>
{{#js}}
require(['core/copy_to_clipboard']);
{{/js}}
