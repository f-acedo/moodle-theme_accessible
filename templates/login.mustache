{{!
    @template theme_accessible/login

    Accessible login page template.

    Context variables required for this template:
    * output - The core renderer for the page
    * bodyattributes - attributes for the body tag as a string of html attributes

    Example context (json):
    {
        "output": {
            "doctype": "<!DOCTYPE html>",
            "htmlattributes": "lang=\"en\" dir=\"ltr\"",
            "page_title": "Login",
            "favicon": "favicon.ico",
            "main_content": "<h1>Log in</h1>"
        },
        "accessibilityurl": "https://yourmoodlesite/theme/accessible/preferences.php",
        "accessibilitylabel": "Accessibility options",
        "bodyattributes": ""
    }
}}
{{> theme_accessible/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="d-print-block">
    {{{ output.standard_top_of_body_html }}}
    <a href="{{ accessibilityurl }}" class="accessible-options-link aabtn">
        <i class="fa-solid fa-universal-access" aria-hidden="true"></i>
        <span class="visually-hidden">{{ accessibilitylabel }}</span>
    </a>
    <div id="page" class="container-fluid">
        <div id="page-content" class="pb-3 d-print-block">
            <div id="region-main-box">
                <div id="region-main">
                    {{{ output.main_content }}}
                </div>
            </div>
        </div>
        <footer id="page-footer" class="py-3 text-center">
            {{{ output.standard_footer_html }}}
        </footer>
    </div>
    {{{ output.standard_after_main_region_html }}}
</div>
{{{ output.standard_end_of_body_html }}}
</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
    M.util.js_complete('theme_boost/loader');
});
{{/js}}
