{{!
    @template theme_accessible/guide

    The guide of the theme: a note when it is not in the user's language, the download link and the guide itself.

    Example context (json):
    {
        "notranslation": "",
        "downloadurl": "https://example.com/theme/accessible/guide.php?download=1",
        "content": "<h2 id=\"1-what-accessible-is\">1. What Accessible is</h2><p>Text.</p>"
    }
}}
<div class="accessible-guide">
    {{{notranslation}}}
    <p><a class="btn btn-secondary" href="{{{downloadurl}}}">{{#pix}} t/download, core {{/pix}} {{#str}} guidedownload, theme_accessible {{/str}}</a></p>
    <div class="accessible-guide-content">
        {{{content}}}
    </div>
</div>
