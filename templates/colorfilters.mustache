{{!
    @template theme_accessible/colorfilters

    Colour vision filters (SVG), referenced from the stylesheet by the user's colour vision option.

    Each filter simulates the missing cone (Machado et al. 2009, scaled by strength) and moves the lost red/green or
    blue difference into the channels the user can still see. White, grey and black are left unchanged.

    Example context (json):
    {}
}}
<svg width="0" height="0" focusable="false" aria-hidden="true" style="position: absolute;">
    <filter id="accessible-colortype-protan-mild">
        <feColorMatrix type="matrix" values="1.0000 0.0000 0.0000 0 0
                                              0.1916 0.7908 0.0177 0 0
                                              0.2389 -0.2755 1.0366 0 0
                                              0 0 0 1 0"/>
    </filter>
    <filter id="accessible-colortype-protan-medium">
        <feColorMatrix type="matrix" values="1.0000 0.0000 0.0000 0 0
                                              0.3352 0.6338 0.0309 0 0
                                              0.4181 -0.4821 1.0640 0 0
                                              0 0 0 1 0"/>
    </filter>
    <filter id="accessible-colortype-protan-strong">
        <feColorMatrix type="matrix" values="1.0000 0.0000 0.0000 0 0
                                              0.4789 0.4769 0.0442 0 0
                                              0.5973 -0.6887 1.0914 0 0
                                              0 0 0 1 0"/>
    </filter>
    <filter id="accessible-colortype-deutan-mild">
        <feColorMatrix type="matrix" values="1.0000 0.0000 0.0000 0 0
                                              0.0651 0.8900 0.0449 0 0
                                              0.1819 -0.2582 1.0763 0 0
                                              0 0 0 1 0"/>
    </filter>
    <filter id="accessible-colortype-deutan-medium">
        <feColorMatrix type="matrix" values="1.0000 0.0000 0.0000 0 0
                                              0.1140 0.8075 0.0785 0 0
                                              0.3183 -0.4518 1.1335 0 0
                                              0 0 0 1 0"/>
    </filter>
    <filter id="accessible-colortype-deutan-strong">
        <feColorMatrix type="matrix" values="1.0000 0.0000 0.0000 0 0
                                              0.1628 0.7250 0.1122 0 0
                                              0.4547 -0.6454 1.1907 0 0
                                              0 0 0 1 0"/>
    </filter>
    <filter id="accessible-colortype-tritan-mild">
        <feColorMatrix type="matrix" values="0.8965 -0.1629 0.2664 0 0
                                              0.0300 0.8341 0.1359 0 0
                                              0.0000 0.0000 1.0000 0 0
                                              0 0 0 1 0"/>
    </filter>
    <filter id="accessible-colortype-tritan-medium">
        <feColorMatrix type="matrix" values="0.8188 -0.2850 0.4662 0 0
                                              0.0526 0.7097 0.2378 0 0
                                              0.0000 0.0000 1.0000 0 0
                                              0 0 0 1 0"/>
    </filter>
    <filter id="accessible-colortype-tritan-strong">
        <feColorMatrix type="matrix" values="0.7412 -0.4072 0.6660 0 0
                                              0.0751 0.5852 0.3397 0 0
                                              0.0000 0.0000 1.0000 0 0
                                              0 0 0 1 0"/>
    </filter>
    <filter id="accessible-colortype-mono">
        <feColorMatrix type="saturate" values="0"/>
    </filter>
</svg>
